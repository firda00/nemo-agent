NEMO_NEWS_FEEDS=                # vergul bilan qo'shimcha RSS manzillari

# ---- Bosqich 2 (LLM ulanadi) ----
NEMO_LLM=rules                  # rules | anthropic
ANTHROPIC_API_KEY=
NEMO_LLM_MODEL=claude-opus-5

# ---- Bosqich 3 (integratsiyalar) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CALENDAR_ICS_URL=
YOUTUBE_API_KEY=
GOOGLE_ADS_CUSTOMER_ID=
